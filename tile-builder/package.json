{
	"name": "wallet",
	"private": true,
	"version": "1.0.2",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
		"format": "prettier --write '**/*.{scss,html,cjs,js,ts,tsx,md}' --ignore-path .prettierignore",
		"format:check": "prettier '**/*.{scss,html,cjs,js,ts,tsx,md}' --ignore-path .prettierignore --check",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.5",
		"@typescript-eslint/eslint-plugin": "8.71.2",
		"eslint": "10.13.0",
		"immutable": "5.1.9",
		"prettier": "3.9.10",
		"sass": "1.105.2",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vite-compatible-readable-stream": "3.6.1",
		"vite-plugin-minify": "3.0.0",
		"vite-plugin-singlefile": "2.3.3"
	},
	"dependencies": {
		"@selemondev/shiki-transformer-copy-button": "1.1.0",
		"shiki": "4.5.0"
	}
}
